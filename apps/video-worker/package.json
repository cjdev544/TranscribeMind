{
  "name": "@transcribemind/video-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@transcribemind/config": "*",
    "@transcribemind/contracts": "*",
    "@transcribemind/database": "*",
    "@transcribemind/logger": "*",
    "bullmq": "^5.13.2",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "5.10.1",
    "openai": "^4.63.0",
    "p-limit": "^6.1.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
