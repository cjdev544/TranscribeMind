# Postgres
POSTGRES_USER=transcribemind
POSTGRES_PASSWORD=transcribemind
POSTGRES_DB=transcribemind
DATABASE_URL=postgresql://transcribemind:transcribemind@localhost:5432/transcribemind

# Redis (BullMQ job queues + Pub/Sub status fan-out)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Object storage (LocalStack emulates S3 locally — point AWS SDK at it via S3_ENDPOINT)
S3_BUCKET=transcribemind-videos
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true

# OpenAI (Whisper transcription + GPT-4o summarization) — required, no local stub
OPENAI_API_KEY=sk-replace-me

# gateway-api
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Days a completed video's raw file is kept before the retention job deletes
# it (transcript/summary/chapters are kept forever regardless).
VIDEO_RETENTION_DAYS=30
# Set to true ONLY if the app is actually served over HTTPS — browsers
# silently drop Secure cookies on plain HTTP, which breaks login.
COOKIE_SECURE=false

# Google Sign-In (OAuth 2.0 Client ID from Google Cloud Console — leave unset to disable)
# Authorized JavaScript origin must include http://localhost:5173 in development.
GOOGLE_CLIENT_ID=
